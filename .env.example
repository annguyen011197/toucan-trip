# Optional. Without it the app runs the offline Travel AI (rule-based, follows the same chat flow).
# Server-only: never exposed to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Model for restaurant/hotel search (Google Search grounding, billed per grounded request). Defaults to GEMINI_MODEL.
GEMINI_RESEARCH_MODEL=

# Firebase Auth (required) — Firebase console › Project settings › Your apps (web).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (required, server-only) — Project settings › Service accounts › Generate new private key.
# Used to verify ID tokens and add the `role: authenticated` claim Supabase needs.
FIREBASE_CLIENT_EMAIL=
# Paste the PEM on one line with literal \n, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=

# Supabase (required) — Dashboard › Project Settings › API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_…): used by /api/auth/sync to upsert profiles. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional map tiles. CARTO Voyager needs a free key (https://carto.com/basemaps/apikey); restrict it to your
# domains in the CARTO dashboard since it's visible in the browser. Without it the map uses OpenStreetMap tiles.
NEXT_PUBLIC_CARTO_API_KEY=

# Place photos come from Wikipedia/Wikimedia Commons (no key). Wikimedia allows 200 requests/min when the
# User-Agent includes contact info (an email or URL), but only 10/min without it. Server-only.
WIKIMEDIA_CONTACT=

# Images (trip covers, stop photos, avatars). Vercel Blob for now: create a *public* Blob store in the Vercel
# project (Storage › Create › Blob) and pull its token. Server-only. Set NEXT_PUBLIC_IMAGE_STORAGE=supabase to
# use the Supabase Storage `media` bucket instead.
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_IMAGE_STORAGE=vercel-blob
# Gemini model for "Generate with AI" images (needs GEMINI_API_KEY).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Debug: log AI route requests/responses and every Gemini round (prompt, function calls, tool results, token
# usage) to the server console. Prints chat text and trips, so keep it off in production.
DEBUG_AI=
# Max chars per log entry (default 20000, 0 = no limit).
DEBUG_AI_MAX_CHARS=
