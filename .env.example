# Optional. Without it the app runs the offline Travel AI (rule-based, follows the same chat flow).
# Server-only: never exposed to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Firebase (Auth + Firestore). Without these, trips are stored in the browser (localStorage).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
